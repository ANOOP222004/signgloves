// =============================================================
// SERIAL COMMANDS
//   cal_show  — print current calibration (from header file or override)
//   cal_open  — OPTIONAL: override calibration manually (open hands)
//   cal_close — OPTIONAL: override calibration manually (close fists)
//   stats     — print inference counters
//   help      — list commands
// =============================================================
void handle_serial(){
    if(!Serial.available()) return;
    String cmd=Serial.readStringUntil('\n'); cmd.trim();

    if(cmd=="cal_open"){
        // Optional manual override — captures open hand snapshot
        delay(300);  // 300ms to let EMA converge after repositioning
        for(int i=0;i<5;i++) cal_open_snap[i]   = ema[i];
        for(int i=0;i<5;i++) cal_open_snap[5+i] = ema[5+i];
        cal_open_done=true;
        Serial.println("\n  [CAL] Step 1 done — open-hand snapshot captured.");
        Serial.println("  Now close BOTH fists tightly, then type: cal_close\n");
    }
    else if(cmd=="cal_close"){
        if(!cal_open_done){ Serial.println("  [CAL] Run cal_open first."); return; }
        delay(300);
        float close_v[10];
        for(int i=0;i<5;i++) close_v[i]   = ema[i];
        for(int i=0;i<5;i++) close_v[5+i] = ema[5+i];
        bool ok2=true;
        for(int i=0;i<10;i++){
            // Store open as cal_min and close as cal_max — preserves direction.
            // Do NOT use min()/max() here: that would invert sensors where open>close.
            cal_min[i] = cal_open_snap[i];
            cal_max[i] = close_v[i];
            if(fabsf(cal_max[i]-cal_min[i]) < 30) ok2=false;
        }
        if(ok2){
            cal_ready=true; cal_open_done=false; cal_from_file=false;
            win_fill=0; win_idx=0; stride_ctr=0;
            last_class=-1; deb_cnt=0;
            memset(win,0,sizeof(win));
            Serial.println("\n  ================================");
            Serial.println("   MANUAL CALIBRATION DONE");
            Serial.println("   (calibration_data.h overridden)");
            Serial.println("  ================================\n");
        } else {
            Serial.println("  [CAL] FAIL — fingers not moving enough.");
            Serial.println("  Ensure magnets are correctly positioned.");
            Serial.println("  Redo: cal_open → cal_close\n");
        }
    }
    else if(cmd=="cal_show"){
        const char* n[]={"R_Thumb","R_Index","R_Middle","R_Ring","R_Little",
                         "L_Thumb","L_Index","L_Middle","L_Ring","L_Little"};
        Serial.println();
        if(cal_from_file) Serial.println("  Calibration source: calibration_data.h");
        else              Serial.println("  Calibration source: manual override");
        Serial.print("  Status: "); Serial.println(cal_ready?"ACTIVE":"NOT DONE");
        for(int i=0;i<10;i++){
            float range=cal_max[i]-cal_min[i];
            Serial.printf("  %-9s  open=%.0f  close=%.0f  range=%.0f%s\n",
                n[i], cal_min[i], cal_max[i], fabsf(range),
                range<0?" (inverted sensor — normal)":"");
        }
        Serial.println();
    }
    else if(cmd=="stats"){
        Serial.printf("  inferences=%lu  last_ms=%.1f  accepted=%lu  slave_pkts=%lu\n",
            total_infer,last_ms,pred_seq,sv_pkts);
    }
    else if(cmd=="help"){
        Serial.println("  cal_show  — print current calibration values");
        Serial.println("  cal_open  — optional manual override (open hands first)");
        Serial.println("  cal_close — optional manual override (close fists)");
        Serial.println("  stats     — inference and packet counters");
    }
}

// =============================================================
// SETUP
// =============================================================
void setup(){
    Serial.begin(115200); delay(2000);

    // Initialise all EMA slots to sentinel
    reset_ema();

    // Allocate TFLite arena (prefer PSRAM, fall back to internal SRAM)
    arena=(uint8_t*)heap_caps_aligned_alloc(16,ARENA_SIZE,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
    if(!arena) arena=(uint8_t*)heap_caps_aligned_alloc(16,ARENA_SIZE,MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);
    if(!arena){Serial.println("FATAL: arena alloc failed");while(1)delay(100);}

    Serial.println("\n================================");
    Serial.println(" Smart Glove — Master Inference");
    Serial.println("================================");

    // ADC + IMU
    analogReadResolution(12);
    analogSetAttenuation(ADC_11db);
    Wire.begin(IMU_SDA,IMU_SCL);
    Wire.setClock(400000);
    imu_ok=imu_init();
    Serial.print("[IMU] "); Serial.println(imu_ok?"OK":"FAIL");
    if(imu_ok){
        for(int i=0;i<SETTLE_FRAMES;i++){imu_update();delay(SAMPLE_MS);}
        imu_y=0;
        Serial.println("[IMU] Settled");
    }

    // WiFi SoftAP
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP("SmartGlove","",1);
    Serial.print("[WiFi] SmartGlove @ "); Serial.println(WiFi.softAPIP());

    // HTTP
    http.on("/",http_root); http.on("/poll",http_poll); http.begin();
    Serial.println("[HTTP] Ready");

    // ESP-NOW
    delay(200); esp_wifi_set_ps(WIFI_PS_NONE);
    if(esp_now_init()==ESP_OK){
        delay(50); esp_now_register_recv_cb(on_slave);
        Serial.println("[ESP-NOW] OK");
    } else {
        Serial.println("[ESP-NOW] FAIL");
    }

    // TFLite
    tfl_model=tflite::GetModel(g_model);
    static tflite::AllOpsResolver res;
    static tflite::MicroErrorReporter rep;
    static tflite::MicroInterpreter interp(tfl_model,res,arena,ARENA_SIZE,&rep);
    tfl_interp=&interp;
    if(tfl_interp->AllocateTensors()!=kTfLiteOk){
        Serial.println("[TFL] FAIL AllocateTensors");
        while(1)delay(100);
    }
    tfl_in=tfl_interp->input(0); tfl_out=tfl_interp->output(0);
    Serial.printf("[TFL] OK  Input 1x%dx%d  Output 1x%d\n",
        tfl_in->dims->data[1],tfl_in->dims->data[2],tfl_out->dims->data[1]);

    // ── Load calibration from calibration_data.h ─────────────────
    // This uses the exact same calibration as live_inference.py,
    // ensuring open→0.0 and close→1.0 on ALL channels regardless
    // of whether a sensor produces higher ADC when open or closed.
    for(int i=0;i<10;i++){
        cal_min[i]=CAL_MIN_DATA[i];
        cal_max[i]=CAL_MAX_DATA[i];
    }
    cal_ready=true;
    cal_from_file=true;

    Serial.println("[CAL] Loaded from calibration_data.h");
    Serial.println("      Type 'cal_show' to verify values");
    Serial.println();
    Serial.println("================================");
    Serial.println(" READY — waiting for left glove ");
    Serial.println("================================");
    Serial.println();
}

// =============================================================
// LOOP — 30 Hz
// =============================================================
unsigned long last_t=0;
int frame_id=0;

void loop(){
    http.handleClient();
    handle_serial();

    unsigned long now=millis();
    if(now-last_t<SAMPLE_MS) return;
    last_t=now;

    // 1. Read right-hand sensors
    int rt=analogRead(PIN_THUMB),  ri=analogRead(PIN_INDEX),
        rm=analogRead(PIN_MIDDLE), rr=analogRead(PIN_RING),
        rl=analogRead(PIN_LITTLE);
    if(imu_ok) imu_update();

    // 2. Update left-hand snapshot from ESP-NOW
    bool sv_alive=(sv_ms>0)&&(millis()-sv_ms<2000);
    if(sv_alive&&sv_new){
        memcpy(&sv_snap,(void*)&sv,sizeof(Slave)); sv_new=false;
    }

    // 3. EMA filter — ALL 16 channels (matches live_inference.py)
    float ef[10];
    ef[0]=ema_f(&ema[0],rt);           ef[1]=ema_f(&ema[1],ri);
    ef[2]=ema_f(&ema[2],rm);           ef[3]=ema_f(&ema[3],rr);
    ef[4]=ema_f(&ema[4],rl);
    ef[5]=ema_f(&ema[5],sv_snap.thumb);  ef[6]=ema_f(&ema[6],sv_snap.index);
    ef[7]=ema_f(&ema[7],sv_snap.middle); ef[8]=ema_f(&ema[8],sv_snap.ring);
    ef[9]=ema_f(&ema[9],sv_snap.little);

    // 4. Build 16-feature frame
    float frame[NUM_RAW];
    for(int i=0;i<5;i++) frame[i]   = norm_finger(i, ef[i]);
    frame[5]  = ema_f(&ema[10], imu_ok?imu_p:0.0f);  // R_Pitch
    frame[6]  = ema_f(&ema[11], imu_ok?imu_r:0.0f);  // R_Roll
    frame[7]  = ema_f(&ema[12], imu_ok?imu_y:0.0f);  // R_Yaw  (dropped by KEEP)
    for(int i=0;i<5;i++) frame[8+i] = norm_finger(5+i, ef[5+i]);
    frame[13] = ema_f(&ema[13], sv_snap.p);            // L_Pitch
    frame[14] = ema_f(&ema[14], sv_snap.r);            // L_Roll
    frame[15] = ema_f(&ema[15], sv_snap.y);            // L_Yaw  (dropped by KEEP)

    win_append(frame);
    stride_ctr++;

    // Gates
    if(!cal_ready){
        if(frame_id%900==0) Serial.println("  [WAIT] cal_ready not set");
        frame_id++; return;
    }
    if(!sv_alive){
        if(frame_id%180==0) Serial.println("  [WAIT] Left glove not connected.");
        frame_id++; return;
    }
    if(win_fill<WINDOW_SIZE){ frame_id++; return; }
    if(stride_ctr<STRIDE){ frame_id++; return; }
    stride_ctr=0;

    float conf;
    int cls=do_inference(&conf);
    if(cls<0){ frame_id++; return; }

    Serial.printf("[PRED] %-10s %3.0f%%\n", LABEL[cls], conf*100);

    int accepted;
    if(stabilise(cls,conf,&accepted)){
        Serial.println();
        Serial.println("  +-------------------------------+");
        Serial.printf( "  |  >> %-10s  %5.1f%%     |\n", LABEL[accepted],conf*100);
        Serial.println("  +-------------------------------+");
        Serial.println();
        pred_word=LABEL[accepted]; pred_seq++;
    }

    frame_id++;
}
