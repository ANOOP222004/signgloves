#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <esp_mac.h>
#include <esp_wifi.h>
#include <math.h>
#include <TensorFlowLite_ESP32.h>
#include "tensorflow/lite/micro/all_ops_resolver.h"
#include "tensorflow/lite/micro/micro_error_reporter.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/schema/schema_generated.h"
#include "model_data.h"
#include "calibration_data.h"   // ← generated by gen_cal_header.py

// ── pins ──────────────────────────────────────────────────────
#define PIN_THUMB   1
#define PIN_INDEX   2
#define PIN_MIDDLE  3
#define PIN_RING    4
#define PIN_LITTLE  5
#define IMU_SDA     8
#define IMU_SCL     9

// ── IMU ───────────────────────────────────────────────────────
#define MPU_ADDR   0x68
#define ACCEL_SC   16384.0f
#define GYRO_SC    131.0f
#define DT         0.033f
#define COMP_G     0.98f
#define COMP_A     0.02f

// ── pipeline constants (must match live_inference.py / config.py) ──
#define EMA_ALPHA          0.25f
#define EMA_UNINIT         -9999.0f  // sentinel: outside ADC (0-4095) AND IMU (-180..180)
#define WINDOW_SIZE        60
#define NUM_RAW            16        // all sensor channels
#define NUM_FEAT           14        // after dropping R_Yaw(7) and L_Yaw(15)
#define NUM_CLASS          10
#define STRIDE             5         // run inference every N frames (~6/sec at 30 Hz)
#define CONF_THRESH        0.85f
#define DEBOUNCE           3
#define COOLDOWN_MS        1500
#define SETTLE_FRAMES      50
#define SAMPLE_MS          33        // 30 Hz loop period

// ── KEEP: indices to keep after dropping yaw channels ────────
// Matches FEATURE_IDX = [0,1,2,3,4,5,6,8,9,10,11,12,13,14] in notebook
static const int KEEP[NUM_FEAT] = {
    0,1,2,3,4,5,6,       // R_Thumb, R_Index, R_Middle, R_Ring, R_Little, R_Pitch, R_Roll
    8,9,10,11,12,13,14   // L_Thumb, L_Index, L_Middle, L_Ring, L_Little, L_Pitch, L_Roll
};

// ── gesture labels — must match label_map.json index order ────
// Generated from config.py GESTURE_LABELS order (do not change)
const char* LABEL[NUM_CLASS] = {
    "HELLO","STOP","YES","NO","THANKYOU",
    "SORRY","HELP","WATER","PLEASE","MORE"
};

// ── TFLite ────────────────────────────────────────────────────
#define ARENA_SIZE (100*1024)
uint8_t* arena = nullptr;
const tflite::Model*      tfl_model  = nullptr;
tflite::MicroInterpreter* tfl_interp = nullptr;
TfLiteTensor *tfl_in = nullptr, *tfl_out = nullptr;

// ── sliding window ────────────────────────────────────────────
float win[WINDOW_SIZE][NUM_RAW];
int   win_idx = 0, win_fill = 0, stride_ctr = 0;

// ── IMU state ─────────────────────────────────────────────────
float imu_p=0, imu_r=0, imu_y=0;
bool  imu_ok = false;

// ── EMA state: 16 channels ────────────────────────────────────
// [0-4] : R fingers, [5-9] : L fingers
// [10-12]: R IMU (pitch, roll, yaw), [13-15]: L IMU (pitch, roll, yaw)
float ema[16];

// ── calibration ───────────────────────────────────────────────
// cal_min = open hand ADC value    (normalizes to 0.0)
// cal_max = closed hand ADC value  (normalizes to 1.0)
//
// For sensors where open > close, cal_min > cal_max (negative range).
// norm_finger() handles this correctly — negative range is intentional.
// norm_finger formula: v = clamp((val - cal_min) / (cal_max - cal_min), 0, 1)
//   open:  v = (cal_min - cal_min) / range = 0.0  ✓
//   close: v = (cal_max - cal_min) / range = 1.0  ✓  (works even when range < 0)
float cal_min[10], cal_max[10];
float cal_open_snap[10];
bool  cal_open_done = false;
bool  cal_ready     = false;
bool  cal_from_file = false;  // true when loaded from calibration_data.h

// ── stabilisation ─────────────────────────────────────────────
int   last_class     = -1;
int   deb_cnt        = 0;
unsigned long last_accept_ms = 0;
unsigned long total_infer    = 0;
float last_ms = 0;

// ── ESP-NOW slave ─────────────────────────────────────────────
typedef struct { int thumb,index,middle,ring,little; float p,r,y; } Slave;
volatile Slave sv;
volatile bool  sv_new = false;
volatile unsigned long sv_ms   = 0;
volatile unsigned long sv_pkts = 0;
Slave sv_snap = {2048,2048,2048,2048,2048, 0,0,0};

// ── web server ────────────────────────────────────────────────
WebServer http(80);
String    pred_word = "";
unsigned long pred_seq = 0;

// =============================================================
// EMA FILTER
// Sentinel EMA_UNINIT: initialise to raw on first call.
// -9999 is safely outside ADC (0-4095) AND IMU (-180..180).
// =============================================================
float ema_f(float* s, float raw){
    if(*s < -9000.0f) *s = raw;
    else *s = EMA_ALPHA*raw + (1.0f - EMA_ALPHA)**s;
    return *s;
}

// =============================================================
// NORMALISE FINGER 0-1
// Matches live_inference.py _normalize() exactly:
//   norm = clamp((ema_val - cal_min) / (cal_max - cal_min), 0, 1)
//
// NEGATIVE RANGE is handled correctly and intentionally:
//   Some sensors give higher ADC when open than closed.
//   In that case cal_min > cal_max → range is negative.
//   Formula still gives: open→0.0, close→1.0 ✓
//   The clamp deals with any values outside [0,1].
// =============================================================
float norm_finger(int ch, float ema_val){
    float range = cal_max[ch] - cal_min[ch];
    // fabsf: handles both positive and negative range
    if(!cal_ready || fabsf(range) < 1.0f) return ema_val / 4095.0f;
    float v = (ema_val - cal_min[ch]) / range;
    if(v < 0.0f) v = 0.0f;
    if(v > 1.0f) v = 1.0f;
    return v;
}

// =============================================================
// IMU
// =============================================================
void imu_wr(uint8_t r, uint8_t v){
    Wire.beginTransmission(MPU_ADDR); Wire.write(r); Wire.write(v);
    Wire.endTransmission(true);
}
bool imu_init(){
    imu_wr(0x6B,0); delay(100);
    imu_wr(0x19,7); imu_wr(0x1A,3); imu_wr(0x1B,0); imu_wr(0x1C,0);
    Wire.beginTransmission(MPU_ADDR); Wire.write(0x75); Wire.endTransmission(false);
    Wire.requestFrom(MPU_ADDR,1,true);
    return Wire.available() && Wire.read()==0x68;
}
void imu_update(){
    Wire.beginTransmission(MPU_ADDR); Wire.write(0x3B); Wire.endTransmission(false);
    Wire.requestFrom(MPU_ADDR,14,true);
    auto rd=[&](){ return (int16_t)((Wire.read()<<8)|Wire.read()); };
    float ax=rd()/ACCEL_SC, ay=rd()/ACCEL_SC, az=rd()/ACCEL_SC;
    Wire.read(); Wire.read();
    float gx=rd()/GYRO_SC, gy=rd()/GYRO_SC, gz=rd()/GYRO_SC;
    float pa = atan2f(ax, sqrtf(ay*ay+az*az)) * 180.0f/(float)PI;
    float ra = atan2f(-ay, az) * 180.0f/(float)PI;
    imu_p = COMP_G*(imu_p + gx*DT) + COMP_A*pa;
    imu_r = COMP_G*(imu_r + gy*DT) + COMP_A*ra;
    imu_y += gz*DT;
    if(imu_y >  180.0f) imu_y -= 360.0f;
    if(imu_y < -180.0f) imu_y += 360.0f;
}

// =============================================================
// ESP-NOW CALLBACK
// =============================================================
void on_slave(const uint8_t* mac, const uint8_t* data, int len){
    if(len == sizeof(Slave)){
        memcpy((void*)&sv, data, sizeof(Slave));
        sv_new = true; sv_ms = millis(); sv_pkts++;
    }
}

// =============================================================
// WINDOW APPEND
// =============================================================
void win_append(const float* f){
    for(int i=0;i<NUM_RAW;i++) win[win_idx][i] = f[i];
    win_idx = (win_idx+1) % WINDOW_SIZE;
    if(win_fill < WINDOW_SIZE) win_fill++;
}

// =============================================================
// Z-SCORE PREPROCESSING
// Matches preprocess() in notebook Section 3 exactly.
// Handles static poses (tiny std) with a 1e-6 floor on std.
// =============================================================
void build_tensor(){
    int start = win_idx;

    float mean[NUM_FEAT] = {};
    for(int t=0; t<WINDOW_SIZE; t++){
        int i=(start+t)%WINDOW_SIZE;
        for(int k=0;k<NUM_FEAT;k++) mean[k]+=win[i][KEEP[k]];
    }
    for(int k=0;k<NUM_FEAT;k++) mean[k]/=WINDOW_SIZE;

    float var[NUM_FEAT] = {};
    for(int t=0; t<WINDOW_SIZE; t++){
        int i=(start+t)%WINDOW_SIZE;
        for(int k=0;k<NUM_FEAT;k++){float d=win[i][KEEP[k]]-mean[k];var[k]+=d*d;}
    }
    float sd[NUM_FEAT];
    for(int k=0;k<NUM_FEAT;k++){
        sd[k]=sqrtf(var[k]/WINDOW_SIZE);
        if(sd[k]<1e-6f) sd[k]=1e-6f;
    }

    float* dst=tfl_in->data.f;
    for(int t=0; t<WINDOW_SIZE; t++){
        int i=(start+t)%WINDOW_SIZE;
        for(int k=0;k<NUM_FEAT;k++) *dst++=(win[i][KEEP[k]]-mean[k])/sd[k];
    }
}

// =============================================================
// INFERENCE
// =============================================================
int do_inference(float* conf_out){
    build_tensor();
    unsigned long t0=micros();
    if(tfl_interp->Invoke()!=kTfLiteOk){Serial.println("[ERR] Invoke");return -1;}
    last_ms=(micros()-t0)/1000.0f; total_infer++;
    float* o=tfl_out->data.f;
    int best=0; float bv=o[0];
    for(int i=1;i<NUM_CLASS;i++) if(o[i]>bv){bv=o[i];best=i;}
    *conf_out=bv; return best;
}

// =============================================================
// STABILISATION
// =============================================================
bool stabilise(int cls, float conf, int* accepted){
    if(conf<CONF_THRESH) return false;
    if(last_accept_ms>0&&(millis()-last_accept_ms)<COOLDOWN_MS) return false;
    if(cls==last_class) deb_cnt++;
    else{ deb_cnt=1; last_class=cls; }
    if(deb_cnt>=DEBOUNCE){
        *accepted=cls; deb_cnt=0; last_accept_ms=millis(); return true;
    }
    return false;
}

// =============================================================
// RESET EMA (called after calibration change or on recal)
// =============================================================
void reset_ema(){
    for(int i=0;i<16;i++) ema[i]=EMA_UNINIT;
}

